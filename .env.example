# Peec AI
# Get your API key from: https://app.peec.ai/settings/api
PEEC_API_KEY=your_peec_api_key_here
PEEC_PROJECT_ID=your_project_id_here

# HubSpot
# Create a Private App with crm.objects.deals.read scope
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# Google Search Console
# Service account JSON keyfile path (or set as inline JSON string)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.key.json
GSC_PROPERTY_URI=sc:domain:example.com

# Optional
DAYS_BACK=30